{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "^0.8.28"],
    "func-visibility": ["error", {"ignoreConstructors": true}],
    "max-line-length": ["error", 110],
    "gas-custom-errors": "error",
    "interface-starts-with-i": "error",
    "no-global-import": "error",
    "named-parameters-mapping": "off",
    "no-empty-blocks": "off",
    "ordering": "off",
    "reason-string": "off",
    "one-contract-per-file": "off",
    "avoid-low-level-calls": "off",

    "use-natspec": ["error", {"author": {"enabled": false}, "param": {"enabled": false}, "return": {"enabled": false}}],

    "function-max-lines": ["error", 60],
    "max-states-count": ["error", 24],

    "import-path-check": "off",
    "gas-indexed-events": "off",
    "gas-strict-inequalities": "off",
    "gas-increment-by-one": "off",
    "gas-struct-packing": "off",
    "gas-small-strings": "off"
  }
}
